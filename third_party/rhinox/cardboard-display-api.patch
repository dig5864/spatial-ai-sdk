+int CardboardUnity_configureSpatialOptics(const char* mesh_id,
+    const char* mesh_hash, int screen_width, int screen_height,
+    float ipd, float near_plane, float left, float right, float top, float bottom) {
+  if (!mesh_id || !mesh_hash || std::strcmp(mesh_id, "rhinox-pro-sharp-2k-separate") != 0 ||
+      std::strcmp(mesh_hash, cardboard::unity::kRhinoXMeshHash) != 0 ||
+      screen_width <= 0 || screen_height <= 0 ||
+      !std::isfinite(ipd) || ipd <= 0 || !std::isfinite(near_plane) || near_plane <= 0 ||
+      !std::isfinite(left) || left >= 0 || !std::isfinite(right) || right <= 0 ||
+      !std::isfinite(top) || top <= 0 || !std::isfinite(bottom) || bottom >= 0) return 0;
+  {
+    std::lock_guard<std::mutex> lock(cardboard::unity::spatial_optics_mutex);
+    cardboard::unity::spatial_optics = {true, screen_width, screen_height,
+        ipd, near_plane, left, right, top, bottom};
+  }
+  cardboard::unity::CardboardDisplayApi::SetDeviceParametersChanged();
+  return 1;
+}
+
+void CardboardUnity_clearSpatialOptics() {
+  {
+    std::lock_guard<std::mutex> lock(cardboard::unity::spatial_optics_mutex);
+    cardboard::unity::spatial_optics = {};
+  }
+  cardboard::unity::spatial_optics_applied = false;
+  cardboard::unity::CardboardDisplayApi::SetDeviceParametersChanged();
+}
+
+int CardboardUnity_isSpatialOpticsApplied() {
+  return cardboard::unity::spatial_optics_applied ? 1 : 0;
+}
+
+int CardboardUnity_configureSpatialTracking(float pitch_degrees, float y_offset,
+    float imu_x, float imu_y, float imu_z,
+    float frame_x, float frame_y, float frame_z, float frame_w) {
+  if (!std::isfinite(pitch_degrees) || std::abs(pitch_degrees) > 45.0f ||
+      !std::isfinite(y_offset) || std::abs(y_offset) >= 0.5f ||
+      !std::isfinite(imu_x) || std::abs(imu_x) >= 0.5f ||
+      !std::isfinite(imu_y) || std::abs(imu_y) >= 0.5f ||
+      !std::isfinite(imu_z) || std::abs(imu_z) >= 0.5f ||
+      !std::isfinite(frame_x) || !std::isfinite(frame_y) ||
+      !std::isfinite(frame_z) || !std::isfinite(frame_w)) return 0;
+  const float frame_length_squared = frame_x * frame_x + frame_y * frame_y +
+      frame_z * frame_z + frame_w * frame_w;
+  if (std::abs(frame_length_squared - 1.0f) > 0.01f) return 0;
+  const float radians = pitch_degrees * 0.017453292519943295f;
+  const float c = std::cos(radians);
+  const float s = std::sin(radians);
+  // Param_RhinoXPro: EyeRender2Design * DesignEye2IMU, followed by the
+  // OpenGL-to-Unity Z flip. In Unity, eye_from_imu has pitch +pitch_degrees;
+  // invert it to obtain the center-eye pose relative to the IMU.
+  const float eye_from_imu_y = c * imu_y + s * imu_z + y_offset;
+  const float eye_from_imu_z = s * imu_y - c * imu_z;
+  const float inverse_pitch = -radians;
+  // q_designImu_from_CardboardHead is an explicit frame adapter. The initial
+  // profile uses identity after Cardboard's landscape/head conversion; its
+  // physical axis alignment has not yet been verified on the device.
+  const float frame_scale = 1.0f / std::sqrt(frame_length_squared);
+  const std::array<float, 4> head_from_design_imu = {
+      -frame_x * frame_scale, -frame_y * frame_scale,
+      -frame_z * frame_scale, frame_w * frame_scale};
+  const std::array<float, 4> design_imu_from_eye = {
+      std::sin(inverse_pitch * 0.5f), 0, 0,
+      std::cos(inverse_pitch * 0.5f)};
+  const auto multiply = [](const std::array<float, 4>& a,
+                           const std::array<float, 4>& b) {
+    return std::array<float, 4>{
+        a[3]*b[0] + a[0]*b[3] + a[1]*b[2] - a[2]*b[1],
+        a[3]*b[1] - a[0]*b[2] + a[1]*b[3] + a[2]*b[0],
+        a[3]*b[2] + a[0]*b[1] - a[1]*b[0] + a[2]*b[3],
+        a[3]*b[3] - a[0]*b[0] - a[1]*b[1] - a[2]*b[2]};
+  };
+  const std::array<float, 4> head_from_eye =
+      multiply(head_from_design_imu, design_imu_from_eye);
+  const float vx = imu_x, vy = eye_from_imu_y, vz = eye_from_imu_z;
+  const float tx = 2.0f * (head_from_eye[1]*vz - head_from_eye[2]*vy);
+  const float ty = 2.0f * (head_from_eye[2]*vx - head_from_eye[0]*vz);
+  const float tz = 2.0f * (head_from_eye[0]*vy - head_from_eye[1]*vx);
+  const std::array<float, 7> imu_from_eye_pose = {
+      -(vx + head_from_eye[3]*tx + head_from_eye[1]*tz - head_from_eye[2]*ty),
+      -(vy + head_from_eye[3]*ty + head_from_eye[2]*tx - head_from_eye[0]*tz),
+      -(vz + head_from_eye[3]*tz + head_from_eye[0]*ty - head_from_eye[1]*tx),
+      head_from_eye[0], head_from_eye[1], head_from_eye[2], head_from_eye[3]};
+  {
+    std::lock_guard<std::mutex> lock(cardboard::unity::spatial_tracking_mutex);
+    cardboard::unity::spatial_imu_from_eye_pose = imu_from_eye_pose;
+    cardboard::unity::spatial_tracking_enabled = true;
+  }
+  LOGD("Spatial AI IMU-to-eye design reference active: pitch %.4f, eye-from-IMU %.4f %.4f %.4f",
+       pitch_degrees, imu_x, eye_from_imu_y, eye_from_imu_z);
+  return 1;
+}
+
+int CardboardUnity_getSpatialTracking(float* imu_from_eye_pose) {
+  if (!imu_from_eye_pose) return 0;
+  std::lock_guard<std::mutex> lock(cardboard::unity::spatial_tracking_mutex);
+  if (!cardboard::unity::spatial_tracking_enabled) return 0;
+  std::memcpy(imu_from_eye_pose, cardboard::unity::spatial_imu_from_eye_pose.data(),
+              sizeof(float) * 7);
+  return 1;
+}
+
+void CardboardUnity_clearSpatialTracking() {
+  std::lock_guard<std::mutex> lock(cardboard::unity::spatial_tracking_mutex);
+  cardboard::unity::spatial_tracking_enabled = false;
+}
