@@ -154,4 +154,24 @@ UnityXRPose CardboardTransformToUnityPose(
   return ret;
 }
 
+UnityXRPose CardboardImuToEyePose(
+    const std::array<float, 4>& imu_rotation,
+    const std::array<float, 7>& imu_from_eye_pose) {
+  const UnityXRPose imu = CardboardRotationToUnityPose(imu_rotation);
+  const UnityXRVector3 eye_offset = {
+      imu_from_eye_pose[0], imu_from_eye_pose[1], imu_from_eye_pose[2]};
+  const UnityXRVector4 eye_rotation = {
+      imu_from_eye_pose[3], imu_from_eye_pose[4],
+      imu_from_eye_pose[5], imu_from_eye_pose[6]};
+  UnityXRPose eye;
+  eye.rotation = QuatMul(imu.rotation, eye_rotation);
+  // A 3DoF IMU has no world translation. Use only the rotation-dependent
+  // lever arm and keep the nominal/recentered center eye at the origin.
+  eye.position = QuatMulVec(imu.rotation, eye_offset);
+  eye.position.x -= eye_offset.x;
+  eye.position.y -= eye_offset.y;
+  eye.position.z -= eye_offset.z;
+  return eye;
+}
+
 }  // namespace cardboard::unity
