+struct RhinoXMeshStorage {
+  std::vector<float> vertices;
+  std::vector<float> uvs;
+  std::vector<int> indices;
+  CardboardMesh mesh{};
+};
+
+RhinoXMeshStorage MakeRhinoXMesh(const float* positions, const float* uv4,
+                                 int component_count,
+                                 const unsigned int* triangles,
+                                 int triangle_index_count) {
+  RhinoXMeshStorage out;
+  if (component_count <= 0 || component_count % 3 != 0 ||
+      triangle_index_count <= 0 || triangle_index_count % 3 != 0) return out;
+  const int vertex_count = component_count / 3;
+  out.vertices.reserve(vertex_count * 2);
+  out.uvs.reserve(vertex_count * 2);
+  for (int i = 0; i < vertex_count; ++i) {
+    // RhinoX Pro mesh positions are full-screen clip coordinates. The
+    // historical UVs are [-1, 1]; preserve the historical V direction.
+    out.vertices.push_back(positions[i * 3]);
+    out.vertices.push_back(positions[i * 3 + 1]);
+    out.uvs.push_back((uv4[i * 4] + 1.0f) * 0.5f);
+    out.uvs.push_back((uv4[i * 4 + 1] + 1.0f) * 0.5f);
+  }
+  // Cardboard uses GL_TRIANGLE_STRIP; SXR stores independent triangles.
+  // Six indices per following triangle preserve winding via degenerate joins.
+  out.indices.reserve(3 + (triangle_index_count / 3 - 1) * 6);
+  for (int i = 0; i < triangle_index_count; i += 3) {
+    const int a = static_cast<int>(triangles[i]);
+    const int b = static_cast<int>(triangles[i + 1]);
+    const int c = static_cast<int>(triangles[i + 2]);
+    if (a >= vertex_count || b >= vertex_count || c >= vertex_count) return {};
+    if (i != 0) {
+      const int last = out.indices.back();
+      out.indices.insert(out.indices.end(), {last, last, a, a, b, c});
+    } else {
+      out.indices.insert(out.indices.end(), {a, b, c});
+    }
+  }
+  out.mesh = {out.indices.data(), static_cast<int>(out.indices.size()),
+              out.vertices.data(), out.uvs.data(), vertex_count};
+  return out;
+}
+
+RhinoXMeshStorage& RhinoXMesh(CardboardEye eye) {
+  static RhinoXMeshStorage left = MakeRhinoXMesh(
+      gXimmerseAR_WarpMesh_Verts_L, gXimmerseAR_WarpMesh_UVs_L,
+      gXimmerseAR_WarpMesh_Verts_L_Count, gXimmerseAR_WarpMesh_Tris_L,
+      gXimmerseAR_WarpMesh_Tris_L_Count);
+  static RhinoXMeshStorage right = MakeRhinoXMesh(
+      gXimmerseAR_WarpMesh_Verts_R, gXimmerseAR_WarpMesh_UVs_R,
+      gXimmerseAR_WarpMesh_Verts_R_Count, gXimmerseAR_WarpMesh_Tris_R,
+      gXimmerseAR_WarpMesh_Tris_R_Count);
+  return eye == CardboardEye::kLeft ? left : right;
+}
